# Client-side (public, safe to expose). Already present in .env for this project.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PROJECT_ID=YOUR_PROJECT_REF
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# ──────────────────────────────────────────────────────────────────────────
# SERVER-SIDE ONLY. Do NOT put this in .env, in client code or in git.
# API.Bible key used by the Supabase edge functions (bible-versions, bible-msg).
# Set it as a Supabase secret instead:
#   supabase secrets set API_BIBLE_KEY=your-key-here --project-ref YOUR_PROJECT_REF
# or Supabase Dashboard -> Edge Functions -> Secrets -> API_BIBLE_KEY
# For local `supabase functions serve`, put it in supabase/.env.local (git-ignored via *.local).
# ──────────────────────────────────────────────────────────────────────────
# API_BIBLE_KEY=
